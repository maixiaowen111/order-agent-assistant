# 复制为 .env 并填上你的配置
# 注意：.env 已被 .gitignore 忽略，绝不提交到 git
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# 下面三个变量两个服务共用，不填时 docker compose 会用各自默认值（本地开发开箱即用）。
# 生产环境必须显式设置，别用默认值：
#   DB_PASSWORD       —— MySQL root 密码（默认 123456 仅供本地）
#   INTERNAL_API_KEY  —— agent 调 order-system 内部接口的密钥（默认仅供本地）
#   JWT_SECRET        —— 两个服务的 JWT 签名密钥（默认仅供本地）
DB_PASSWORD=123456
INTERNAL_API_KEY=order-agent-internal-key-2026
JWT_SECRET=MyOrderSystemSecretKeyForJwtToken2024!!!
