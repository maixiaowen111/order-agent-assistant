# 本机直接跑 order-system（不走 docker compose）时用的环境变量。
# 复制这段说明按需 export（Windows PowerShell: $env:DB_PASSWORD="123456"）。
# docker compose 方式（推荐）由 order-agent-assistant/.env 注入，不需要在这配。
#
# 数据库密码（application-dev.yml 读它，没配启动直接报错）
export DB_PASSWORD=123456
# 内部接口密钥：agent 调 /internal/** 时的 X-Internal-Key，两边必须一致
export INTERNAL_API_KEY=order-agent-internal-key-2026
# JWT 签名密钥：和 order-agent-assistant 的 AgentJwtService 同钥
export JWT_SECRET=MyOrderSystemSecretKeyForJwtToken2024!!!
